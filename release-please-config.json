{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "86469622b92a77a503a210bc0f8d76d039e75efb",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "include-v-in-tag": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "refactor",
          "section": "Code Refactoring"
        },
        {
          "type": "docs",
          "hidden": true
        },
        {
          "type": "style",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "build",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/schluterditraheat/manifest.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
